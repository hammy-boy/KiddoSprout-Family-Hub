{
  "name": "kiddosprout",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:blocker:mac": "zsh mac-blocker/scripts/build-mac-blocker.sh",
    "build:blocker:windows": "sh windows-blocker/scripts/build.sh",
    "build:blockers": "npm run build:blocker:mac && npm run build:blocker:windows && npm run test:blocker-packages",
    "build:public-demo": "npm run build:family-calls && node scripts/build-public-demo.mjs",
    "build:family-calls": "node scripts/build-family-call-client.mjs",
    "build:voice-catalog": "node scripts/build-voice-story-catalog.mjs",
    "dev": "sh scripts/start-local-stack.sh",
    "dev:stop": "sh scripts/stop-local-stack.sh",
    "optimize:story-images": "node scripts/optimize-story-images.mjs",
    "preview:watch": "docker compose -f docker-compose.yml -f docker-compose.public.yml --profile public watch --no-up",
    "preview:stop": "docker compose -f docker-compose.yml -f docker-compose.public.yml --profile public stop cloudflared",
    "preview:status": "node scripts/public-preview-status.mjs",
    "preview:smoke": "node scripts/public-preview-status.mjs --smoke",
    "preview:recover": "node scripts/public-preview-status.mjs --recover",
    "deploy": "npm run deploy:public-demo",
    "deploy:public-demo": "npm run test:public-demo-build && wrangler deploy",
    "check:public-demo-deploy": "npm run test:public-demo-build && wrangler deploy --dry-run",
    "check:email": "node scripts/email-readiness.mjs",
    "check:email:hosted": "node scripts/email-readiness.mjs --hosted",
    "setup:email": "sh scripts/setup-email.sh",
    "test": "npm run test:auth && npm run test:passcode && npm run test:blockers && npm run test:bank && npm run test:voice && npm run test:story && npm run test:hubs && npm run test:calls && npm run test:language-garden && npm run test:games && npm run test:main-ui && npm run test:pwa && npm run test:links && npm run test:language && npm run test:theme && npm run test:accessibility && npm run test:recipes && npm run test:spending-ui && npm run test:recipe-quality && npm run test:report && npm run test:legacy-apps && npm run test:python-preview && npm run test:sprout-tutor && npm run test:public-demo-build",
    "test:bank": "node scripts/test-bank-api.mjs",
    "test:calls": "node scripts/test-family-calls.mjs",
    "test:calls:db": "supabase test db supabase/tests/family_calls_rls_test.sql",
    "test:blocker": "node scripts/test-browser-blocker.mjs",
    "test:blocker-api": "node scripts/test-blocker-api.mjs",
    "test:blocker-packages": "node scripts/test-blocker-packages.mjs",
    "test:blockers": "npm run test:blocker && npm run test:blocker-api && npm run test:blocker-packages",
    "test:demo": "node scripts/test-demo-mode.mjs",
    "test:email": "node scripts/test-email-delivery-config.mjs",
    "test:google-auth": "node scripts/test-google-auth-config.mjs",
    "test:games": "node scripts/test-games-hub.mjs",
    "test:human-check": "node scripts/test-human-check.mjs",
    "test:auth-request-safety": "node scripts/test-auth-request-safety.mjs",
    "test:hubs": "node scripts/test-child-hub-ui.mjs && npm run test:homeschool",
    "test:homeschool": "node scripts/test-homeschool-hub.mjs",
    "test:language": "node scripts/test-language-setting.mjs",
    "test:language-garden": "node scripts/test-language-garden.mjs && node --test scripts/test-language-tutor.cjs",
    "test:links": "node scripts/test-public-links.mjs && npm run test:local-redirect",
    "test:local-redirect": "node scripts/test-local-docker-redirect.mjs",
    "test:main-ui": "node scripts/test-main-ui-safety.mjs",
    "test:pwa": "node scripts/test-pwa-install.mjs",
    "test:passcode": "node scripts/test-passcode-security.mjs",
    "test:legacy-apps": "node scripts/test-legacy-apps.mjs",
    "test:python-preview": "node scripts/test-python-preview-safety.mjs",
    "test:public-preview": "node scripts/test-public-preview.mjs && node scripts/test-public-preview-status.mjs",
    "test:public-demo-build": "node scripts/test-public-demo-build.mjs",
    "test:recipes": "node scripts/test-recipes.mjs",
    "test:recipe-quality": "node scripts/test-recipe-spending-quality.mjs",
    "test:report": "node scripts/test-report-problem.mjs",
    "test:session-safety": "node scripts/test-session-safety.mjs",
    "test:spending-ui": "node scripts/test-smart-spending-ui.mjs",
    "test:sprout-tutor": "node scripts/test-sprout-tutor-integration.mjs && node --test scripts/test-sprout-tutor-worker.mjs",
    "test:story": "node scripts/test-story-reader.mjs",
    "test:theme": "node scripts/test-theme-setting.mjs",
    "test:accessibility": "node scripts/test-accessibility-resilience.mjs",
    "test:voice": "node scripts/build-voice-story-catalog.mjs --check && node scripts/test-voice-api.mjs",
    "test:auth": "npm run test:account-service-config && npm run test:email && npm run test:google-auth && npm run test:human-check && npm run test:auth-request-safety && npm run test:session-safety && npm run test:family-state && npm run test:demo && npm run test:public-preview",
    "test:account-service-config": "node scripts/test-account-service-config.mjs",
    "test:family-state": "node scripts/test-family-state-cloud.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "sharp": "0.35.4",
    "supabase": "2.116.0",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "agents": "0.24.0"
  }
}
