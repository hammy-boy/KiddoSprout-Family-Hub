# The public Cloudflare preview is a fictional-data-only tour by default. It
# starts without account or Turnstile values and does not expose protected APIs.
# Change this to false only after hosted Auth and a real Turnstile widget work.
# `npm run dev` remains local and uses Cloudflare's official development key.
PUBLIC_DEMO_ONLY=true

# Production/deployed account mode only. `npm run dev` discovers local values automatically.
# This must be a browser-safe `sb_publishable_...` key (or legacy anon JWT).
# Never paste an `sb_secret_...` or service-role key into this file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Required when PUBLIC_DEMO_ONLY=false. Use a real production widget sitekey;
# all five official Cloudflare test sitekeys are rejected by public account mode.
TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key

# Optional premium Story Theater narration. Keep the API key server-side.
# The voice ID is an optional default; standard voices are included automatically.
# In ElevenLabs: My Voices > More actions > Copy voice ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Supported Story Theater TTS models: eleven_multilingual_v2, eleven_v3,
# eleven_flash_v2_5, or eleven_flash_v2. Other model IDs fail closed.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional comma-separated family-safe IDs, including any Pro voices to show.
ELEVENLABS_ALLOWED_VOICE_IDS=

# Configure at least one secure parent sign-in route: Google OAuth or SMTP email.
#
# Option A: Google OAuth for the local Supabase stack. Both values are required
# together and stay server-side. Register this exact authorized redirect URI:
# http://127.0.0.1:54321/auth/v1/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# For a hosted/deployed account service, set this browser-safe flag to true only
# after its Google provider has been configured and tested. `npm run dev` derives
# the local value automatically from the two private credentials above.
GOOGLE_AUTH_READY=false

# Option B: signup confirmations and recovery codes for the LOCAL Supabase stack.
# These values stay server-side. Use a verified sender and an SMTP-specific
# password or sending-only API key; the sender display name is fixed to KiddoSprout.
# Resend example: host smtp.resend.com, port 587, user resend, API key as the
# password, and a From address on the exact verified sending domain.
# Hosted Supabase SMTP is configured separately in the Supabase dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# For a hosted/public account service, set this browser-safe flag to true only
# after custom SMTP has been configured and a real delivery test has succeeded.
AUTH_EMAIL_DELIVERY_READY=false

# Smart Spending bank mode. Keep false for every public/deployed environment.
# `npm run dev` deliberately overrides this to true only when both Plaid keys are empty.
BANK_DEMO_MODE=false

# Optional Plaid connection. Sandbox is free test infrastructure with mock bank data;
# it does not connect a real account. Live use needs separately approved Production access.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# UK is the local default. Use comma-separated ISO country codes/products only
# after enabling them in the same Plaid application.
PLAID_COUNTRY_CODES=GB
PLAID_PRODUCTS=auth
# Required by Plaid institutions that use OAuth. This must be the exact public
# HTTPS callback registered in Plaid; leave blank for local non-OAuth demo work.
PLAID_REDIRECT_URI=
PLAID_WEBHOOK_URI=

# Optional server-only encryption key for stored Plaid access tokens. Use exactly
# 32 random bytes encoded as base64 (for example: `openssl rand -base64 32`) or
# 64 hexadecimal characters. Local Docker generates and persists one when empty;
# real Plaid mode requires this stable key through the production secret store.
BANK_TOKEN_ENCRYPTION_KEY=
