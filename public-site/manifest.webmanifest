{
  "name": "KiddoSprout",
  "short_name": "KiddoSprout",
  "id": "./",
  "lang": "en-GB",
  "dir": "ltr",
  "description": "A family hub for child profiles, parent approvals, learning, recipes, spending, stories, movement, reports, and safe app access.",
  "start_url": "./#login",
  "scope": "./",
  "display": "standalone",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "categories": ["education", "lifestyle"],
  "prefer_related_applications": false,
  "background_color": "#f4faf7",
  "theme_color": "#3fa35b",
  "orientation": "any",
  "icons": [
    {
      "src": "kiddosprout_logo_128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "kiddosprout_logo_192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "kiddosprout_logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Parent Dashboard",
      "short_name": "Parent",
      "description": "Open the KiddoSprout parent dashboard.",
      "url": "./#parent",
      "icons": [{ "src": "kiddosprout_logo_128.png", "sizes": "128x128" }]
    },
    {
      "name": "Child Site",
      "short_name": "Child",
      "description": "Open the approved child experience.",
      "url": "./#child",
      "icons": [{ "src": "kiddosprout_logo_128.png", "sizes": "128x128" }]
    },
    {
      "name": "FlavorNest",
      "short_name": "Recipes",
      "description": "Open family recipes in FlavorNest.",
      "url": "./recipe.html",
      "icons": [{ "src": "kiddosprout_logo_128.png", "sizes": "128x128" }]
    }
  ]
}
