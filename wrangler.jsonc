{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kiddosprout",
  "main": "src/sprout-tutor-worker.mjs",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "KIDDOSPROUT_ACCOUNT_MODE": "true"
  },
  "secrets": {
    "required": [
      "KIDDOSPROUT_ACCOUNT_ORIGIN",
      "SUPABASE_URL",
      "SUPABASE_PUBLISHABLE_KEY",
      "TURNSTILE_SITE_KEY"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "TUTOR_RATE_LIMITER",
      "namespace_id": "73026",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SproutTutorAgent",
        "class_name": "SproutTutorAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SproutTutorAgent"]
    }
  ],
  "assets": {
    "directory": "./.cloudflare/public-demo",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
