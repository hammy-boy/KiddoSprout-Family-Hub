{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kiddosprout",
  "main": "src/sprout-tutor-worker.mjs",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "TUTOR_RATE_LIMITER",
      "namespace_id": "73026",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SproutTutorAgent",
        "class_name": "SproutTutorAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SproutTutorAgent"]
    }
  ],
  "assets": {
    "directory": "./.cloudflare/public-demo",
    "binding": "ASSETS",
    "run_worker_first": ["/agents/*", "/api/sprout-tutor/*", "/supabase-config.js"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
