FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS story-catalog
WORKDIR /catalog
COPY story-theater.html story-library-data.js story-ethan-leo-data.js ./
COPY scripts/build-voice-story-catalog.mjs ./scripts/build-voice-story-catalog.mjs
RUN node ./scripts/build-voice-story-catalog.mjs --root /catalog --output /catalog/trusted-story-catalog.json

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
ENV NODE_ENV=production
WORKDIR /app
COPY server/voice-api.mjs /app/voice-api.mjs
COPY server/account-service-config.mjs /app/account-service-config.mjs
COPY --from=story-catalog /catalog/trusted-story-catalog.json /app/trusted-story-catalog.json
USER node
EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8787/health').then((response)=>process.exit(response.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["node", "/app/voice-api.mjs"]
